# ─── accounts environment ─────────────────────────────────────────────────────
# Copy to `.env` and fill in. Never commit `.env`.

# --- Core / database ---
DATABASE_URL=postgresql+psycopg://accounts:accounts@postgres:5432/accounts
REDIS_URL=redis://redis:6379/0
# Password of the compose postgres service (must match DATABASE_URL).
POSTGRES_PASSWORD=accounts

# --- Sessions ---
# Ed25519 private key (base64url 32-byte seed). Generate: python -m dbcore.cli genkey
# Empty = a throwaway key is generated at startup (local only; sessions die on restart).
SESSION_SIGNING_KEY=
# Public keys kept in the JWKS during a rotation (comma-separated base64url).
SESSION_PREVIOUS_PUBLIC_KEYS=
SESSION_TTL_MIN=15
REFRESH_TTL_DAYS=30
# Cookie scope. Production: .3m4.net (shared by every app). Local: empty (host-only on localhost).
COOKIE_DOMAIN=
COOKIE_SECURE=false
# Issuer claim and the public base URL of this service.
ACCOUNTS_URL=http://localhost:8085
# Origins allowed for credentialed CORS and return_to redirects (comma-separated; * matches one label or any port).
ALLOWED_ORIGINS=https://3m4.net,https://*.3m4.net,http://localhost:*,http://127.0.0.1:*
# Secret for the short-lived signed OAuth state cookie and other HMACs.
SECRET_KEY=change-me-secret
# Salt for hashing client IPs stored on sessions (never raw IPs).
IP_HASH_SECRET=change-me-ip-hash-secret

# --- OAuth providers (a provider is enabled when both values are set) ---
# Callback URL to register at each provider: ${ACCOUNTS_URL}/api/auth/oauth/<provider>/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=

# --- Outbound mail (verification + magic links). Disabled => mails are logged and skipped ---
MAIL_ENABLED=false
# smtp://user:pass@host:587?starttls=1 | smtps://user:pass@host:465 | smtp://mailpit:1025 (local)
# Production (Resend): smtp://resend:re_xxx@smtp.resend.com:587?starttls=1
# (Hetzner blocks outbound 465 on new servers; 587 + STARTTLS is open and equivalent.)
SMTP_URL=
MAIL_FROM=3m4 accounts <no-reply@3m4.net>

# --- PostHog (optional; no-ops if unset). Shared project; flag keys are prefixed. ---
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PERSONAL_API_KEY=
POSTHOG_FLAG_PREFIX=accounts-
# Pin individual switches: FEATURE_FLAG_OVERRIDES=site-building=on,signups=off
FEATURE_FLAG_OVERRIDES=

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=120/minute

# --- Frontend (Vite, build-time). Prefix MUST be VITE_ ---
VITE_API_URL=http://localhost:8085/api
VITE_APP_URL=http://localhost:8085
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_INFO_URL=https://info.3m4.net
# metrics web analytics (https://metrics.3m4.net): the project's PUBLIC key. Empty = no tracker.
VITE_METRICS_PROJECT_KEY=
VITE_METRICS_TRACKER_URL=https://metrics.3m4.net/m.js
# retro feedback widget (https://retro.3m4.net): the project's PUBLIC key. Empty = no widget.
VITE_RETRO_PROJECT_KEY=
VITE_RETRO_WIDGET_URL=https://retro.3m4.net/widget.js
